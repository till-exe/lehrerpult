{
  "name": "lehrerpult",
  "version": "0.4.1",
  "description": "Lehrerpult",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist:win": "vite build && electron-builder --win nsis --x64"
  },
  "author": "Till",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.3",
    "vite": "^8.3.7"
  },
  "productName": "Lehrerpult",
  "type": "module",
  "build": {
    "appId": "de.lehrerpult.app",
    "productName": "Lehrerpult",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lehrerpult",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lehrerpult-Setup-${version}.exe"
    },
    "publish": null
  }
}
